# ==============================================================================
# SECURE ONLINE EXAMINATION PORTAL - CONFIGURATION & CREDENTIALS
# ==============================================================================

# GEMINI_API_KEY: Required for Gemini AI API calls (chatbot & assistant)
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
# Optional: override the chatbot model. The default is gemini-flash-latest.
GEMINI_MODEL="gemini-flash-latest"

# Comma-separated administrator invite codes used during admin provisioning.
# Set unique, private values before deployment.
ADMIN_INVITE_CODES="SECURE-ADMIN-2026,APEX-EXAM-BOARD,ROOT-PROCTOR-99"

# APP_URL: The URL where this applet is hosted
APP_URL="MY_APP_URL"

# ------------------------------------------------------------------------------
# 1. GMAIL SMTP CONFIGURATION (Nodemailer Email OTP Delivery)
# ------------------------------------------------------------------------------
# Set your Gmail account address and generated Google 16-character App Password.
# How to generate a Gmail App Password:
#   1. Visit your Google Account: https://myaccount.google.com/
#   2. Navigate to "Security" -> Ensure "2-Step Verification" is Turned ON.
#   3. Search or navigate to "App passwords" (https://myaccount.google.com/apppasswords).
#   4. Create a new App Password (e.g. named "SecureExam Portal").
#   5. Copy the generated 16-character password into GMAIL_APP_PASSWORD (no spaces).
GMAIL_USER="your-email@gmail.com"
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"

# ------------------------------------------------------------------------------
# 2. FIREBASE AUTHENTICATION & CLOUD FIRESTORE
# ------------------------------------------------------------------------------
# Client-side configuration is automatically read from /firebase-applet-config.json.
# Project ID: earnest-order-98p5g
# Database ID: ai-studio-secureonlineexam-4877a177-f8a1-493f-ab29-b19a1b1b84c4
# Phone SMS OTP: Uses Firebase Phone Authentication with reCAPTCHA.
# For local testing, add authorized test phone numbers in Firebase Console:
#   Phone: +1 650-555-1234  Code: 123456

# ------------------------------------------------------------------------------
# 3. WEBAUTHN / PASSKEYS & BIOMETRIC AUTHENTICATION
# ------------------------------------------------------------------------------
# Supported standard: FIDO2 WebAuthn (TouchID, FaceID, Windows Hello, YubiKey)
# Enabled by default in modern browsers using navigator.credentials.

# ------------------------------------------------------------------------------
# 4. SERVER-SIDE DEVICE ENROLLMENT & CREDENTIAL SECURITY
# ------------------------------------------------------------------------------
# Cryptographic salt used for hashing device tokens, credentials, and single-account locks.
# If omitted, the server dynamically generates and persists a cryptographically secure 256-bit salt.
SECURITY_SALT="your_secure_random_256bit_salt_here"
